# Copy to .env.local and fill in. .env.local is git-ignored and must stay that way.
# None of these values are secret except HYDRA_TOKEN, and that one never leaves
# the server process: no browser bundle, no log line, no screenshot.

# Base URL of the HydraDB HTTP query API. The client refuses to send a bearer
# token over plain http to anything other than loopback.
HYDRA_HTTP_URL=http://127.0.0.1:18443

# Graph scope. A request carries the namespace as a header and the cell in the
# body; HydraDB rejects a request that names a namespace the token cannot read.
HYDRA_NAMESPACE=
HYDRA_GRAPH=
HYDRA_CELL=

# Bearer token for the HydraDB node. Local development tokens are disposable.
# Never put a real one here, and never commit this file with a value.
HYDRA_TOKEN=

# Server-only browser voice credentials. The permanent key is exchanged for a
# single-use Scribe token and is never included in the web bundle.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_TTS_MODEL_ID=eleven_flash_v2_5

# Server-only bearer used by the one daily Vercel cron dispatcher.
CRON_SECRET=

# Optional stable key for opaque graph cursors. HYDRA_TOKEN is used when this
# is absent on a cloud deployment.
# LACUNA_GRAPH_CURSOR_KEY=

# Opt out of the loopback-only check above. Only set this when the transport is
# TLS or the network is genuinely trusted, and understand what you are doing.
# HYDRA_ALLOW_PLAINTEXT_REMOTE=false
