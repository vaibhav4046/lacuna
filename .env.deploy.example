# Server-side configuration for the deployment. Copy to .env.deploy and fill in.
# .env.deploy is gitignored. Nothing here reaches the browser bundle.

# --- HydraDB: the one that actually unlocks the deployed product -------------
# A node the Vercel function can reach over the internet. The local WSL node on
# 127.0.0.1 is not reachable from a serverless function, which is why the
# deployed app currently reports no node.
HYDRA_HTTP_URL=
HYDRA_NAMESPACE=
HYDRA_GRAPH=
HYDRA_CELL=
HYDRA_TOKEN=

# --- Model providers: any one is enough --------------------------------------
GROQ_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# --- Voice: optional ---------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Sessions ----------------------------------------------------------------
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
LACUNA_SESSION_SECRET=

# Accounts need a writable directory. On Vercel only /tmp is writable, and it
# does not survive between invocations, so accounts are per-instance there.
LACUNA_ACCOUNTS_DIR=/tmp/lacuna-store
LACUNA_SECURE_COOKIES=1
