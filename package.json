{
  "name": "lacuna",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Memory that knows what changed, what remains true, and what was never known.",
  "engines": {
    "node": ">=20.11.0"
  },
  "bin": {
    "lacuna": "bin/lacuna.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm --prefix web run build",
    "web": "npm --prefix web run dev",
    "smoke:web": "tsx scripts/smoke-web.ts",
    "cli": "node bin/lacuna.js",
    "serve": "tsx scripts/serve.ts",
    "mcp": "tsx scripts/mcp.ts",
    "ingest": "tsx scripts/ingest.ts",
    "census": "tsx scripts/census.ts",
    "reset": "tsx scripts/reset.ts",
    "bench": "tsx scripts/benchmark.ts",
    "eval": "tsx scripts/evaluate.ts",
    "snapshot": "tsx scripts/export-snapshot.ts",
    "snapshot:verify": "tsx scripts/verify-snapshot.ts",
    "serve:snapshot": "tsx scripts/serve-snapshot.ts",
    "parity": "tsx scripts/parity.ts",
    "screens": "tsx scripts/screens.ts",
    "test": "vitest run tests/unit",
    "test:contract": "vitest run tests/contract",
    "test:all": "vitest run"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "hash-wasm": "4.12.0"
  }
}
