{
  "name": "lacuna",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Memory that knows what changed, what remains true, and what was never known.",
  "engines": {
    "node": ">=20.11.0"
  },
  "bin": {
    "lacuna": "bin/lacuna.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm --prefix web run build",
    "web": "npm --prefix web run dev",
    "smoke:web": "tsx scripts/smoke-web.ts",
    "cli": "node bin/lacuna.js",
    "serve": "tsx scripts/serve.ts",
    "mcp": "tsx scripts/mcp.ts",
    "ingest": "tsx scripts/ingest.ts",
    "census": "tsx scripts/census.ts",
    "reset": "tsx scripts/reset.ts",
    "bench": "tsx scripts/benchmark.ts",
    "bench:longmemeval": "tsx benchmarks/longmemeval/run.ts",
    "bench:longmemeval:verify": "tsx scripts/longmemeval-verify.ts",
    "bench:longmemeval:judge": "tsx scripts/longmemeval-judge.ts",
    "eval": "tsx scripts/evaluate.ts",
    "snapshot": "tsx scripts/export-snapshot.ts",
    "snapshot:verify": "tsx scripts/verify-snapshot.ts",
    "serve:snapshot": "tsx scripts/serve-snapshot.ts",
    "parity": "tsx scripts/parity.ts",
    "screens": "tsx scripts/screens.ts",
    "test": "vitest run tests/unit",
    "test:contract": "vitest run tests/contract",
    "test:all": "vitest run",
    "ingest:cloud": "tsx scripts/ingest-cloud.ts",
    "parity:cloud": "tsx scripts/cloud-parity.ts",
    "smoke:demo": "tsx scripts/smoke-demo.ts",
    "smoke:mcp": "tsx scripts/smoke-mcp.ts",
    "continuity": "tsx scripts/continuity.ts",
    "smoke:auth": "tsx scripts/smoke-auth.ts",
    "smoke:google": "tsx scripts/smoke-google-auth.ts",
    "smoke:voice": "tsx scripts/smoke-voice.ts",
    "proof": "tsx scripts/proof.ts",
    "capture:cli": "tsx scripts/capture-cli.ts",
    "capture:motion": "tsx scripts/capture-browser-motion.ts",
    "copy:lint": "tsx scripts/copy-lint.ts",
    "audit:landing": "tsx scripts/landing-visual-audit.ts",
    "soak": "tsx scripts/soak.ts",
    "audit:routes": "tsx scripts/route-audit.ts",
    "node:heal": "bash -c \"wsl.exe -e bash -lc 'cd /mnt/d/project/lacuna && bash scripts/hydra-node.sh heal' && npm run ingest && npm run census\"",
    "test:verified": "tsx scripts/verify-suite.ts"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@types/node": "^26.2.0",
    "@types/yauzl": "3.4.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fastify/busboy": "3.2.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "hash-wasm": "4.12.0",
    "pdfjs-dist": "4.10.38",
    "yauzl": "3.4.0"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "sharp": "0.35.3"
  }
}
