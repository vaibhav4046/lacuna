# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
.next/
out/
dist/
build/
*.tsbuildinfo

# Environment. Only .env.example is committed, and it holds no real values.
.env
.env.local
.env.*.local
!.env.example

# Secrets, in any shape. Belt and braces on top of the rule above.
*.pem
*.key
*_rsa
*.p12
auth-token
**/auth-token

# Test and coverage output
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/
.playwright/

# Local HydraDB state. Never committed: it is a database, not source.
.hydradb/
.lacuna-store/

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp

# Logs
*.log
npm-debug.log*
yarn-error.log*

# Derived data. Embedding vectors and downloaded model weights rebuild from
# source on demand, and megabytes of floats do not belong in history.
.cache/

# Local scratch. Anything a developer wants to keep out of the tree.
/scratch/
/tmp/

# Throwaway probes. Scripts written to measure one thing against a live node and
# then deleted. The measurements they produced live in DECISIONS.md, which is
# the part worth keeping.
*.tmp.ts

# Local assistant tooling state. Not part of the project.
.claude/

# The raw design drop. `design/reference/` holds the artifacts the product was
# built against and is committed on purpose; this is the unpacked archive it was
# taken out of, two hundred files of variants, uploads and vendor handoff notes.
# Keeping the source of an asset is provenance. Keeping the shipping crate is
# not.
design/incoming2/

.vercel
.worktrees/

# Deployment configuration. Values only, never committed.
.env.deploy

# Rendered video output is generated, large, and distributed through the
# owner-approved video host rather than Git.
video/hyperframes/renders/*.mp4
video/hyperframes/snapshots/
video/hyperframes/.thumbnails/
# Clean voice-clone audio is biometric source material. Keep it local and
# publish only its reproducibility metadata, hash, captions, and mixed film.
video/hyperframes/assets/narration-vaibhav/*.mp3
# Local preview-only inputs, downloaded environments, and exploratory captures
# must never become submission evidence by accident.
video/hyperframes/.venv-kokoro/
video/hyperframes/auditions/
video/hyperframes/capture-live/
video/hyperframes/narration.wav
# V10 judge-film source recordings, biometric narration, snapshots and renders
# are generated locally. Keep only the declarative project, capture manifests,
# checksums, captions and review metadata in Git.
video/hyperframes-v10/assets/captures/*.mp4
video/hyperframes-v10/assets/cuts/
video/hyperframes-v10/assets/private-voice/
video/hyperframes-v10/.media/
video/hyperframes-v10/renders/
video/hyperframes-v10/snapshots/
video/hyperframes-v10/review/
video/hyperframes-v10/review-clean/
video/hyperframes-v10/.thumbnails/
# HyperFrames' local agent packets and instruction mirrors are authoring state,
# not release source. The declarative brief, storyboard, composition and
# capture metadata remain tracked explicitly.
video/hyperframes-v10/.hyperframes/
video/hyperframes-v10/AGENTS.md
video/hyperframes-v10/CLAUDE.md
.env.cloud

# The LongMemEval dataset, downloaded not committed. 15MB to 2.7GB.
/data/

.env*
